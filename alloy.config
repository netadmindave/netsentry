// Grafana Alloy -> Loki. (Promtail is deprecated; Alloy is its replacement.)
// Mount NPM's data/logs dir at /logs/npm, HA's config dir at /logs/ha, AdGuard's work dir at /logs/adguard.

loki.write "local" {
  endpoint { url = "http://LOKI_HOST:3100/loki/api/v1/push" }
}

// UDM Pro, Unraid and Proxmox remote syslog -> udp/1514 on this host
loki.relabel "syslog" {
  forward_to = []
  rule {
    source_labels = ["__syslog_message_hostname"]
    target_label  = "host"
  }
}

loki.source.syslog "net" {
  listener {
    address       = "0.0.0.0:1514"
    protocol      = "udp"
    syslog_format = "rfc3164"   // UniFi/BSD-style syslog; drop this line if your devices send RFC5424
    labels        = { job = "syslog" }
  }
  relabel_rules = loki.relabel.syslog.rules
  forward_to    = [loki.write.local.receiver]
}

local.file_match "npm" {
  path_targets = [{ __path__ = "/logs/npm/proxy-host-*_access.log", job = "npm" }]
}
loki.source.file "npm" {
  targets    = local.file_match.npm.targets
  forward_to = [loki.write.local.receiver]
}

local.file_match "ha" {
  path_targets = [{ __path__ = "/logs/ha/home-assistant.log", job = "homeassistant" }]
}
loki.source.file "ha" {
  targets    = local.file_match.ha.targets
  forward_to = [loki.write.local.receiver]
}

local.file_match "adguard" {
  path_targets = [{ __path__ = "/logs/adguard/data/querylog.json", job = "adguard" }]
}
loki.source.file "adguard" {
  targets    = local.file_match.adguard.targets
  forward_to = [loki.write.local.receiver]
}
